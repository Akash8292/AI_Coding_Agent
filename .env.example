# ═══════════════════════════════════════════════════════════════════════════════
# CodeSage Environment Configuration Example
# Copy this file to .env and configure your variables
# ═══════════════════════════════════════════════════════════════════════════════

# App Core
PORT=5000
DEBUG=false
JWT_SECRET=change-this-to-a-secure-random-secret-key-32-chars-minimum
JWT_EXPIRY_HOURS=168

# Database
# Default: SQLite in local directory.
# For production (PostgreSQL): postgresql://user:password@hostname:5432/codesage
DATABASE_URL=sqlite:///codesage.db

# CORS Configuration (comma-separated origins or * for all)
CORS_ORIGINS=*

# Default Provider: openai | anthropic | gemini | openrouter | kimi | ollama
LLM_PROVIDER=openai

# ── Cloud LLM Providers (Configure at least one) ─────────────────────────────
# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Google Gemini
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# OpenRouter (Access to 200+ models with one key)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Kimi (Moonshot AI)
KIMI_API_KEY=sk-...
KIMI_MODEL=moonshot-v1-8k
KIMI_BASE_URL=https://api.moonshot.ai/v1

# ── Local Ollama (Optional — disabled by default in production) ──────────────
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=codellama

# ── Indexing & Semantic Search (Optional) ───────────────────────────────────
# EMBEDDING_PROVIDER: none (BM25/keyword only) | openai | ollama
EMBEDDING_PROVIDER=none
OPENAI_EMBED_MODEL=text-embedding-3-small
OLLAMA_EMBED_MODEL=nomic-embed-text
INDEX_CACHE_DIR=./index_cache
MAX_EDIT_FILE_BYTES=300000

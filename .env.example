# ═══════════════════════════════════════════════════════════════════════════════
# CodeSage configuration — copy to .env and fill in what you need.
# Only JWT_SECRET (in production) and ONE provider API key are required.
# ═══════════════════════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────────────────────
FLASK_ENV=development            # production enables strict defaults (see README)
PORT=5000
JWT_SECRET=change-me-to-a-long-random-string   # REQUIRED in production
JWT_EXPIRY_HOURS=168
LOG_LEVEL=INFO

# Database: SQLite by default (relative paths live in backend/instance/).
# Production: postgresql://user:password@host:5432/codesage
DATABASE_URL=sqlite:///codesage.db

# Cross-origin API access. Empty = same origin only (the frontend is served by
# the backend). Development defaults to "*".
CORS_ORIGINS=

# ── LLM providers (configure at least one) ────────────────────────────────────
LLM_PROVIDER=gemini             # default provider for new chats

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional: force a thinking level (minimal|low|medium|high). Empty = model default,
# with CodeSage automatically using "low" for simple single-file edits.
GEMINI_THINKING_LEVEL=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.6-flash

KIMI_API_KEY=
KIMI_MODEL=kimi-k2.7-code
KIMI_BASE_URL=https://api.moonshot.ai/v1

# ── Ollama (OPTIONAL local provider — never required) ────────────────────────
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=codellama

# ── Request limits ───────────────────────────────────────────────────────────
LLM_CONNECT_TIMEOUT=10          # seconds to establish the connection
LLM_FIRST_TOKEN_TIMEOUT=270      # seconds until the model produces output
LLM_IDLE_TIMEOUT=60             # max silence mid-stream
LLM_TOTAL_TIMEOUT=300           # hard ceiling per LLM request
LLM_MAX_ATTEMPTS=2              # retries only for rate limits / 5xx / network, before any output
ANSWER_MAX_OUTPUT_TOKENS=8192
EDIT_MAX_OUTPUT_TOKENS=32768
CONTEXT_MAX_TOKENS=60000        # repository context budget per request
HISTORY_MAX_TOKENS=20000
SEARCH_TIMEOUT_SECONDS=30
COMMAND_TIMEOUT_SECONDS=60
COMMAND_MAX_OUTPUT_BYTES=50000

# Per-user limits
MAX_REQUESTS_PER_MINUTE=30
MAX_TOKENS_PER_DAY=2000000
MAX_CONCURRENT_REQUESTS_PER_USER=2

# ── Workspaces ───────────────────────────────────────────────────────────────
# Multi-user servers: users may only use folders under WORKSPACE_ROOT/<user_id>/
# (or clone a git URL there). Local single-user development may allow any path.
WORKSPACE_ROOT=./workspaces
# Unset = true in development, false in production. Never set true on a shared server.
# ALLOW_ANY_WORKSPACE_PATH=
ALLOW_GIT_CLONE=true
MAX_EDIT_FILE_BYTES=300000

# ── Indexing / semantic search (optional) ────────────────────────────────────
EMBEDDING_PROVIDER=none         # none (BM25 keyword search) | openai | ollama
OPENAI_EMBED_MODEL=text-embedding-3-small
OLLAMA_EMBED_MODEL=nomic-embed-text
INDEX_CACHE_DIR=./index_cache
